{
  "kind": "collectionType",
  "collectionName": "subdirections",
  "info": {
    "singularName": "subdirection",
    "pluralName": "subdirections",
    "displayName": "Subdirection",
    "description": "One procedure under a direction (Лікування карієсу, Брекети…): its entry in the direction's list, with the photograph shown beside it, and the page it leads to."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "image": {
      "type": "component",
      "component": "utilities.basic-image",
      "repeatable": false
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "direction": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::direction.direction",
      "inversedBy": "subdirections"
    },
    "page": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::page.page"
    },
    "works": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::work.work",
      "mappedBy": "subdirection"
    }
  }
}
