      "repeatable": false,
      "required": true
    },
    "after": {
      "type": "component",
      "component": "utilities.basic-image",
      "repeatable": false
    },
    "doctor": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::doctor.doctor",
      "inversedBy": "works"
    },
    "direction": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::direction.direction",
      "inversedBy": "works"
    },
    "subdirection": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::subdirection.subdirection",
      "inversedBy": "works"
    },
    "order": {
      "type": "integer",
      "default": 0
    }
